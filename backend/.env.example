# Flask & Security
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-key
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# Database (PostgreSQL - Neon / Local)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/pfa-dog-sterilization-db?sslmode=require

# CORS (comma-separated allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage (local or r2)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Cloudflare R2 (only used when STORAGE_BACKEND=r2; fill in at Step B7b)
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=dog-sterilization-media-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_EXPIRY=3600

# Public QR / Info Page
PUBLIC_BASE_URL=http://localhost:5000
NGO_CONTACT_TEXT=Animal Welfare NGO Helpline: +91-00000-00000

# Seed Script Credentials (used in Step A6)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=change-me-admin-password
VOLUNTEER_EMAIL=volunteer@ngo.org
VOLUNTEER_PASSWORD=change-me-volunteer-password

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
FLASK_DEBUG=0